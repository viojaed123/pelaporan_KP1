# ============================================================
# ai-service/.env.example
# Salin menjadi `.env` lalu sesuaikan nilainya:
#   Copy-Item .env.example .env
#
# Semua variabel memakai awalan AI_ (sama dengan konstanta di
# includes/config.php sisi PHP). Variabel yang tidak diisi memakai
# nilai bawaan di app/config.py.
# ============================================================

# --- Identitas & HTTP -------------------------------------------------------
# WAJIB sama persis dengan AI_SERVICE_KEY di includes/config.php.
AI_SERVICE_KEY=ganti-kunci-layanan-ai-disini
AI_HOST=127.0.0.1
AI_PORT=8000
AI_LOG_LEVEL=info
# true hanya untuk pengembangan: /docs & /openapi.json jadi bebas kunci.
AI_DOCS_PUBLIC=false

# --- Google Gemini (model utama) -------------------------------------------
# Kunci AI Studio (https://aistudio.google.com/apikey). Kosong = pakai Ollama saja.
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash
AI_GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
# Model khusus Google Search grounding (alat web_search).
AI_GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
AI_GEMINI_SEARCH_TIMEOUT=30

# --- Ollama / model (cadangan lokal bila Gemini gagal) ---------------------
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b
AI_MODEL_FALLBACK=qwen2.5:3b
AI_NUM_CTX=8192
AI_TEMPERATURE=0.2
AI_TOP_P=0.9
AI_KEEP_ALIVE=10m
AI_REQUEST_TIMEOUT=120
AI_CONNECT_TIMEOUT=5
AI_MAX_RETRIES=2
AI_MAX_TOOL_ITERATIONS=6
AI_HEALTH_TIMEOUT=4
# false (bawaan): Ollama mati => HTTP 503 {"detail": ...}.
# true: pakai hasil deterministik (tanpa model) saat Ollama mati.
AI_DEGRADE_DETERMINISTIC=false
AI_HISTORY_LIMIT=10

# --- Basis data -------------------------------------------------------------
AI_DB_HOST=localhost
AI_DB_PORT=3306
AI_DB_NAME=pelaporan
AI_DB_APP_USER=pelaporan_app
AI_DB_APP_PASSWORD=GantiDenganKataSandiKuat_2026!
AI_DB_READONLY_USER=bi_reader
AI_DB_READONLY_PASSWORD=BI_ReadOnly_Kuat_2026!
# true: kueri baca memakai akun baca-saja; bila belum diberi hak,
# layanan otomatis jatuh ke akun aplikasi (dicatat sebagai peringatan).
AI_DB_PREFER_READONLY=true
AI_DB_CONNECT_TIMEOUT=5

# --- Ekspor dokumen ---------------------------------------------------------
# Relatif terhadap folder ai-service/ bila bukan jalur absolut.
AI_EXPORT_DIR=exports

# --- Pencadangan basis data -------------------------------------------------
# Sama dengan BACKUP_DIR pada config.php PHP (../backups/db).
AI_BACKUP_DIR=../backups/db
AI_MYSQLDUMP_BIN=C:\xampp\mysql\bin\mysqldump.exe
AI_MYSQL_BIN=C:\xampp\mysql\bin\mysql.exe
AI_BACKUP_KEEP=10
# false: alat restore_database selalu menolak (pengaman ganda).
AI_RESTORE_AKTIF=true
AI_PROSES_TIMEOUT=300

# --- Pekerja antrean (ai_jobs) ---------------------------------------------
AI_JOBS_POLL_INTERVAL=3
AI_JOBS_BATCH=1
AI_JOBS_ENABLED=true

# --- Pencarian web (alat web_search) ---------------------------------------
# Aktifkan/nonaktifkan seluruh pencarian internet.
AI_WEB_SEARCH_AKTIF=true
# Alamat instans SearXNG (mis. http://127.0.0.1:8888).
# Kosongkan bila belum ada; alat akan memakai cadangan DuckDuckGo.
AI_SEARXNG_URL=
AI_WEB_SEARCH_TIMEOUT=12
AI_WEB_SEARCH_HASIL=5
# Lama cache hasil pencarian (menit) untuk menghemat permintaan.
AI_WEB_SEARCH_CACHE_MENIT=5
# Jalur berkas PEM berisi CA tambahan untuk verifikasi TLS (mis. sertifikat root proxy).
# AI_HTTP_CA_BUNDLE=C:\xampp\htdocs\pelaporan\ai-service\cacert.pem
