{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "phr/pelaporan-harian",
    "type": "project",
    "description": "Sistem Pelaporan Kegiatan Harian PHR — Laravel 12, Eloquent, keamanan berlapis, notifikasi, AI lokal, Power BI.",
    "keywords": ["laravel", "framework", "pelaporan", "phr"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "phpmailer/phpmailer": "^6.10",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:legacy": [
            "@php vendor/phpunit/phpunit/phpunit -c phpunit-legacy.xml"
        ],
        "test:all": [
            "@php artisan config:clear --ansi",
            "@php artisan test",
            "@php vendor/phpunit/phpunit/phpunit -c phpunit-legacy.xml"
        ],
        "aset:periksa": "@php scripts/sinkron_aset.php --periksa",
        "aset:selaraskan": "@php scripts/sinkron_aset.php",
        "lint": "@php -l app/Http/Controllers/",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
