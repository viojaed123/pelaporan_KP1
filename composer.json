{
  "name": "phr/pelaporan-harian",
  "description": "Sistem Pelaporan Kegiatan Harian PHR — flat PHP (mysqli), keamanan berlapis, notifikasi, AI lokal, Power BI.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "phpmailer/phpmailer": "^6.10",
    "dompdf/dompdf": "^3.1",
    "phpoffice/phpspreadsheet": "^4.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "classmap": [
      "includes/"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform-check": true,
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "scripts": {
    "lint": "php -l includes/*.php *.php",
    "test": "vendor/bin/phpunit"
  }
}
