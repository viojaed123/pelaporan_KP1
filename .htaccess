# =============================================================
# pelaporan -- konfigurasi Apache (XAMPP)
#
# Catatan struktur: proyek kini berisi kerangka Laravel 12 di root yang
# sama dengan halaman flat-PHP lama. Karena itu blok larangan di bawah
# tidak hanya menutup folder lama (includes/, database/) tetapi juga
# seluruh direktori bawaan Laravel yang TIDAK boleh tersaji via HTTP:
# app/, config/, bootstrap/, routes/, resources/, storage/, tests/,
# dan terutama .git/ (riwayat versi + isi .env di dalam commit lama).
#
# .htaccess ini berlaku untuk aplikasi LAMA yang disajikan dari root
# (http://localhost/pelaporan/). Aplikasi Laravel disajikan dari public/
# dan memakai .htaccess-nya sendiri (lihat public/.htaccess).
# =============================================================

# Larang daftar isi direktori (mencegah pemetaan file)
Options -Indexes

# -------------------------------------------------------------
# 1. Blokir akses HTTP ke direktori non-publik
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Direktori proyek (bukan halaman yang dilayankan ke browser) ---
    # Baris lama dipertahankan, ditambah direktori bawaan Laravel +
    # direktori non-web lain (tools/, mobile/, node_modules/, lang/).
    RewriteRule ^(vendor|database|ai-service|scripts|backups|docs|includes|powerbi|tools|mobile|node_modules|lang)(/|$) - [F,L,NC]

    # --- Direktori bawaan Laravel: hanya public/ yang boleh tersaji ---
    RewriteRule ^(app|bootstrap|config|routes|resources|storage|tests)(/|$) - [F,L,NC]

    # --- Repositori Git: JANGAN PERNAH tersaji (berisi riwayat versi) ---
    RewriteRule ^\.git(/|$) - [F,L,NC]

    # --- Berkas konfigurasi / sumber daya sensitif ---
    RewriteRule ^(composer\.(json|lock)|phpunit\.xml|phpunit-legacy\.xml|package\.json|vite\.config\.js|artisan|\.env.*|\.editorconfig|\.gitattributes|\.gitignore|.*\.sql|.*\.ps1|.*\.md|.*\.key)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(composer\.(json|lock)|phpunit.*\.xml|package\.json|vite\.config\.js|artisan|\.env.*|\.gitignore|.*\.(sql|ps1|md|log|key))$">
    Require all denied
</FilesMatch>

# -------------------------------------------------------------
# 2. Header keamanan
# -------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    # Aktifkan HSTS hanya setelah domain memakai HTTPS penuh:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# -------------------------------------------------------------
# 3. Batasi ukuran upload (selaras dengan aturan aplikasi: 5 MB/foto)
# -------------------------------------------------------------
php_value upload_max_filesize 8M
php_value post_max_size 12M
php_value max_file_uploads 6

# -------------------------------------------------------------
# 4. Larang akses langsung ke berkas eksekusi/berkas cadangan.
#    Proteksi `uploads/` ada di uploads/.htaccess,
#    proteksi `backups/` ada di backups/.htaccess.
#    (Blok ini TIDAK memuat ekstensi .php di root --
#     seluruh halaman aplikasi berakhiran .php)
# -------------------------------------------------------------
<FilesMatch "\.(phps|phtml\.bak|ini|conf|bak|swp|sql\.gz|old)$">
    Require all denied
</FilesMatch>

ErrorDocument 403 "Akses ditolak."
